# Copy to .env and supply a UNC Azure subscription key (not a public OpenAI key).
# Azure aliases take precedence: AZURE_OPENAI_API_KEY, AZURE_OPENAI_DEPLOYMENT,
# and AZURE_OPENAI_ENDPOINT. Configure one naming scheme to avoid stale overrides.
OPENAI_API_KEY=

# Set the exact deployment alias enabled for your UNC subscription, without a
# provider prefix. LearnWithAI uses gpt-5.6-luna; confirm availability for your key.
# Required for smoke; a fallback for CodingAgent when Harbor omits --model.
# Prefer Harbor --model / agents[].model_name for reproducible comparisons.
OPENAI_MODEL=

# Endpoint origin only. Clients append /openai/v1/ for the Responses API.
OPENAI_ENDPOINT=https://azureaiapi.cloud.unc.edu
